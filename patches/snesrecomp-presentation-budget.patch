+
+void snes_host_clock_decoupled_simulation_done(SnesHostClock *c, double now,
+                                               bool preserve_debt, double elapsed_periods) {
+  snes_host_clock_simulation_done(c, now, true, elapsed_periods);
+  if (!preserve_debt && c->next_simulation < now - 0.250)
+    c->next_simulation = now;
+}
+
+void snes_host_clock_consumer_paced(SnesHostClock *c, double frame_started, double waited) {
+  if (waited > 0) c->next_simulation = fmax(c->next_simulation, frame_started + waited);
+}
+
+bool snes_host_clock_presentation_allowed(const SnesHostClock *c, double now,
+                                          bool intermediate, bool simulation_throttled) {
+  if (!snes_host_clock_presentation_due(c, now)) return false;
+  if (intermediate) {
+    /* A decaying peak includes composition, upload and blocking vsync.
+     * Until the first measurement, reserve one requested present period. */
+    double cost = c->presentation_cost > 0 ? c->presentation_cost : 1 / c->presentation_hz;
+    return now + cost < c->next_simulation;
+  }
+  /* Audio backpressure already paced this simulation. A wall-clock backlog
+   * must not starve video while waiting for that independent consumer. */
+  return simulation_throttled || !snes_host_clock_simulation_due(c, now) ||
+         now - c->last_presentation_finished >= 0.100;
+}
+
+void snes_host_clock_presentation_finished(SnesHostClock *c, double started, double finished) {
+  snes_host_clock_presentation_done(c, started);
+  c->presentation_cost = fmax(fmax(0, finished - started), c->presentation_cost * 0.95);
+  c->last_presentation_finished = finished;
+}
+
+double snes_host_clock_budget_deadline(const SnesHostClock *c, double now) {
+  /* An unaffordable already-due presentation must not cause a busy wait. */
+  if (snes_host_clock_presentation_due(c, now) &&
+      !snes_host_clock_presentation_allowed(c, now, true, false)) return c->next_simulation;
+  return snes_host_clock_next_deadline(c);
+}
