+/* Experimental scheduler-only HDMA event watermark. Not serialized. */
+static uint64_t s_last_hdma_event = UINT64_MAX;
+
+/* Next reference-style HDMA initialization or scanline slot. The returned
+ * clock is on the beam timeline; callbacks happen only at CPU boundaries. */
+static uint64_t next_hdma_event(bool *init) {
+  uint32_t h = g_snes->hPos, v = g_snes->vPos;
+  uint64_t base = g_snes->beamMasterLast;
+  if (v == 0 && h <= 20 && base + (20u - h) != s_last_hdma_event) {
+    *init = true;
+    return base + 20u - h;
+  }
+  if (v <= 224 && h <= 1106 && base + (1106u - h) != s_last_hdma_event) {
+    *init = false;
+    return base + 1106u - h;
+  }
+  if (v < 224) {
+    *init = false;
+    return base + 1364u - h + 1106u;
+  }
+  *init = true;
+  return base + snes_master_clocks_until_line(g_snes, 0) + 20u;
+}
+
+static void service_hdma_event(bool init, uint64_t event) {
+  uint32_t clocks = init ? dma_initHdmaCounted(g_snes->dma)
+                         : dma_doHdmaCounted(g_snes->dma);
+  s_last_hdma_event = event;
+  if (clocks) {
+    g_cpu.master_cycles += clocks;
+    snes_sync_master_clock(g_snes, g_cpu.master_cycles);
+    cart_sync_coprocessors(g_snes->cart, g_cpu.master_cycles);
+  }
+}
 
