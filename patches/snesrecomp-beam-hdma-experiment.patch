-void dma_initHdma(Dma* dma) {
+uint32_t dma_initHdmaCounted(Dma* dma) {
+  unsigned active = 0;
+  uint32_t clocks = 0;
+  for (int i = 0; i < 8; i++) if (dma->channel[i].hdmaActive) active |= 1u << i;
+  if (active) clocks = 18u;
   for (int i = 0; i < 8; i++) {
     DmaChannel* ch = &dma->channel[i];
     if (!ch->hdmaActive) continue;
