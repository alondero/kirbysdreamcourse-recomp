     ch->tableAdr = ch->aAdr;
     dma_hdmaLoadDescriptor(dma, ch);
+    clocks += 8u;
+    if (ch->indirect)
+      clocks += ch->terminated ? ((active & (0xfeu << i)) ? 16u : 8u) : 16u;
     ch->offIndex = 0;
   }
+  return clocks;
+}
