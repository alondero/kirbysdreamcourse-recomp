+#ifndef SNES_PPU_HD_GPU_H
+#define SNES_PPU_HD_GPU_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+/* Host-owned, transient output of one raster. All row indices are zero-based.
+ * An offset of zero uses the native pixel. A CPU row overrides the GPU result
+ * with the existing Mode 7 renderer or a line whose command buffer filled. */
+typedef struct PpuHdGpuFrame {
+  unsigned width, height, scale;
+  uint32_t *offsets, *words;
+  size_t length, capacity;
+  uint16_t (*palette)[258]; /* CGRAM, fixed colour, brightness and math flags */
+  uint8_t *cpu_rows;
+  uint64_t atlas_epoch;
+  /* Returns a one-based atlas slot, or zero if the image cannot be stored. */
+  unsigned (*add_tile)(const uint8_t *image, bool rgba);
+} PpuHdGpuFrame;
