+#ifdef __ANDROID__
+/* A controller can reach Settings even before it is assigned to player one. */
+static bool AndroidLauncherShortcut(const SDL_Event *event) {
+  if (event->type == SDL_EVENT_KEY_DOWN)
+    return event->key.key == SDLK_MENU && !event->key.repeat;
+  if (event->type != SDL_EVENT_GAMEPAD_BUTTON_DOWN) return false;
+
+  const SDL_GamepadButton button = event->gbutton.button;
+  if (button == SDL_GAMEPAD_BUTTON_GUIDE) return true;
+  if (!g_launcher_gesture.ok || g_launcher_gesture.pad != SNES_PAD_SELECT ||
+      g_launcher_gesture.raw != (1u << kGamepadBtn_L3) ||
+      (button != SDL_GAMEPAD_BUTTON_BACK && button != SDL_GAMEPAD_BUTTON_LEFT_STICK) ||
+      g_gamepad[0].joystick_id == event->gbutton.which)
+    return false;
+  SDL_Gamepad *pad = SDL_GetGamepadFromID(event->gbutton.which);
+  return pad && SDL_GetGamepadButton(pad, SDL_GAMEPAD_BUTTON_BACK) &&
+         SDL_GetGamepadButton(pad, SDL_GAMEPAD_BUTTON_LEFT_STICK);
+}
+#endif
