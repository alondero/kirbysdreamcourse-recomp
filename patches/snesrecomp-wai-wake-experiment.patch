@@ -198,6 +198,16 @@ static void sync_interrupt_entry_hdma(uint64_t *event, bool *init) {
   *event = next_hdma_event(init);
 }
 
+/* Snes9x charges 14 master clocks when an interrupt releases WAI. Preserve
+ * a crossed HDMA deadline while the CPU is unavailable during this wake. */
+static void snes_wai_wake(void) {
+  bool init;
+  uint64_t event = next_hdma_event(&init);
+  g_cpu.master_cycles += 14u;
+  sync_interrupt_entry_hdma(&event, &init);
+  cart_sync_coprocessors(g_snes->cart, g_cpu.master_cycles);
+}
+
 /* Experimental NMI/IRQ entry; interrupt sampling and individual bus-event
  * timing are separate from this paced entry sequence. */
 static void run_interrupt_timed(bool nmi, uint64_t deadline) {
@@ -288,6 +298,7 @@ void snes_beam_frame_driver_run_frame(void) {
     if (g_cpu.master_cycles < trigger)
       advance_parked(trigger);
     g_snes->inNmi = true;
+    if (s_wai_halted) snes_wai_wake();
     s_wai_halted = false;
     run_interrupt_timed(true, frame_end);
     g_snes->inNmi = false;
@@ -310,6 +321,7 @@ void snes_beam_frame_driver_run_frame(void) {
         g_snes->lateNmiDue <= hdma_event) {
