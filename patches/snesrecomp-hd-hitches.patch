+  for (unsigned i = 0; i < 16; ++i)
+    if (memcmp(t->seen_cgram + i * 16 + 1, cgram + i * 16 + 1, 15 * sizeof(*cgram)))
+      if (++t->palette_epoch4[i] == 0) PpuHdTilesForgetCells(t);
+  memcpy(t->seen_cgram, cgram, sizeof(t->seen_cgram));
 }

