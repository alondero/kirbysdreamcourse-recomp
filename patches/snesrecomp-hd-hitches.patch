+   * image. 2bpp palettes are four colours, 4bpp palettes sixteen. A change
+   * to e.g. colour 4 invalidates 4bpp palette 0, but not 2bpp palette 0 or 1.
+   * Compare live contents: HDMA and snapshot restores need no write counter. */
+  for (unsigned i = 0; i < 64; ++i)
+    if (memcmp(t->seen_cgram + i * 4 + 1, cgram + i * 4 + 1, 3 * sizeof(*cgram)))
