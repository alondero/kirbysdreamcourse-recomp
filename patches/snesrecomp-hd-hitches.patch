+static void PpuHdTilesTrimCache(struct PpuHdTiles *t) {
+  /* Rehash between lines: records from the preceding line are no longer
+   * sampled and cell memos are invalidated below. Keep the current/previous
+   * frame's working set, up to half the table, leaving bounded probe space.
+   * A palette changing on every line can exceed that bound; discarded images
+   * are regenerated from their exact queries rather than reused stale. */
+  PpuHdTileEntry *entries = calloc(kPpuHdCacheSlots, sizeof(*entries));
+  if (!entries) {
+    ++t->stats.cache_clears;
+    PpuHdTilesClearCache(t);
+    return;
+  }
+  unsigned count = 0;
+  for (unsigned i = 0; i < kPpuHdCacheSlots; ++i) {
+    PpuHdTileEntry *e = &t->entries[i];
+    if (!e->used) continue;
+    if ((uint32_t)(t->cache_frame - e->last_frame) <= 1 && count < kPpuHdCacheSlots / 2) {
+      unsigned slot = (unsigned)e->hash & (kPpuHdCacheSlots - 1);
+      while (entries[slot].used) slot = (slot + 1) & (kPpuHdCacheSlots - 1);
+      entries[slot] = *e;
+      ++count;
+    } else {
+      free(e->image);
+      ++t->stats.cache_evictions;
+    }
+  }
+  free(t->entries);
+  t->entries = entries;
+  t->count = count;
+  memset(t->memo, 0, sizeof(t->memo));
+  PpuHdTilesForgetCells(t);
+  ++t->stats.cache_trims;
+}
