+/* ---- HD tile replacement: line composition ------------------------------
+ * Resolve each native pixel's recorded sources once at native resolution and
+ * require the exact native priority values and colour. Only then compose its
+ * subpixels from HD images; otherwise copy the native pixel. This keeps
+ * windows, widescreen margins, host objects and anything not modelled here
+ * authoritative, at the cost of native pixels where they occur. */
+typedef struct PpuHdCandidate {
+  const PpuHdTileRecord *rec;
+  const PpuHdImage *image;  /* NULL: sample the native character */
+  const uint8_t *line;      /* this subrow of the texel, NULL when native */
+  int step;                 /* -1 when flipped horizontally */
+  unsigned native_index;
+} PpuHdCandidate;
+
+/* Point each image candidate at subrow sy of its texel, honouring flips. */
+static inline void PpuHdSelectSubrow(PpuHdCandidate *c, unsigned count,
+                                     unsigned scale, unsigned sy) {
+  for (unsigned k = 0; k < count; ++k) {
+    const PpuHdTileRecord *r = c[k].rec;
+    if (!c[k].image) { c[k].line = NULL; continue; }
+    const bool fx = (r->flags & kPpuHdFlipX) != 0;
+    const unsigned y = r->row * scale + ((r->flags & kPpuHdFlipY) ? scale - 1 - sy : sy);
+    c[k].line = c[k].image->indices + y * 8 * scale + r->col * scale + (fx ? scale - 1 : 0);
+    c[k].step = fx ? -1 : 1;
+  }
+}
+
+static inline bool PpuHdTexel(const PpuHdCandidate *c, uint64_t mask) {
+  return (mask >> (c->rec->row * 8 + c->rec->col)) & 1;
+}
+
+enum { kPpuHdResolveFull, kPpuHdResolveNative, kPpuHdResolveWinner };
+/* How one screen's subpixels resolve at this native pixel. Native: all equal
+ * the native value. Winner: all come from the native winner, which is opaque
+ * at every subpixel with every higher source clear. Values share no carry
+ * between the priority byte and the palette byte, so the high byte orders
+ * sources. */
+static inline unsigned PpuHdClassify(const PpuHdCandidate *c, unsigned count,
+                                     unsigned *winner) {
+  unsigned w = count;
+  uint16_t best = 0x0500;
+  for (unsigned k = 0; k < count; ++k) {
+    uint16_t value = (uint16_t)(c[k].rec->z + c[k].native_index);
+    if (c[k].native_index && value > best) { best = value; w = k; }
+  }
+  const unsigned top = w < count ? (unsigned)(c[w].rec->z >> 8) : 0;
+  for (unsigned k = 0; k < count; ++k) {
+    if (k == w) continue;
+    const unsigned level = c[k].rec->z >> 8;
+    if (w < count && level < top) continue;
+    if (w < count && level == top) return kPpuHdResolveFull;
+    const bool clear = c[k].image ? PpuHdTexel(&c[k], c[k].image->clear)
+                                  : c[k].native_index == 0;
+    if (!clear) return kPpuHdResolveFull;
+  }
+  *winner = w;
+  if (w == count || !c[w].image) return kPpuHdResolveNative;
+  if (!PpuHdTexel(&c[w], c[w].image->opaque)) return kPpuHdResolveFull;
+  return PpuHdTexel(&c[w], c[w].image->same) ? kPpuHdResolveNative
+                                              : kPpuHdResolveWinner;
+}
+
+static inline uint16_t PpuHdResolveNative(const PpuHdCandidate *c, unsigned count) {
+  uint16_t best = 0x0500;
+  for (unsigned k = 0; k < count; ++k) {
+    uint16_t value = (uint16_t)(c[k].rec->z + c[k].native_index);
+    if (c[k].native_index && value > best) best = value;
+  }
+  return best;
+}
+
+static inline uint16_t PpuHdResolveAt(const PpuHdCandidate *c, unsigned count,
+                                      unsigned sx) {
+  uint16_t best = 0x0500;
+  for (unsigned k = 0; k < count; ++k) {
+    unsigned index = c[k].line ? c[k].line[(int)sx * c[k].step] : c[k].native_index;
+    uint16_t value = (uint16_t)(c[k].rec->z + index);
+    if (index && value > best) best = value;
+  }
+  return best;
+}
+
+static bool PpuDrawTileHdLine(Ppu *ppu, unsigned line) {
+  struct PpuHdTiles *t = ppu->hdTiles;
+  const PpuMode7HdSurface *surface = &ppu->mode7Hd;
+  if (!t || !t->recording || !line || line > surface->height) return false;
+  const unsigned width = surface->width, scale = surface->scale;
+  if (!ppu->renderBuffer || width != 256u + 2u * ppu->extraLeftRight ||
+      ppu->renderPitch < width * sizeof(uint32_t))
+    return false;
+  const bool sub_rendered = PPU_preventMathMode(ppu) != 3 &&
+      PPU_addSubscreen(ppu) && PPU_mathEnabled(ppu) && ppu->screenEnabled[1] != 0;
+  bool supported = PPU_mode(ppu) == 1 && !PPU_forcedBlank(ppu) &&
+      !PPU_interlace(ppu) && !PPU_pseudoHires(ppu) &&
+      !(PPU_mosaicSize(ppu) > 1 && (ppu->mosaic & 0x0f));
+  for (unsigned source = 0; supported && source < kPpuOverlaySource_Count; ++source)
+    if (PpuOverlayActiveOnLine(ppu, (PpuOverlaySource)source, (int)line - 1))
+      supported = false;
+  /* A layer hidden behind the top pixel cannot be checked per pixel, so every
+   * enabled background must have been recorded for the line. */
+  for (unsigned screen = 0; supported && screen < (sub_rendered ? 2u : 1u); ++screen)
+    for (unsigned layer = 0; layer < 3; ++layer)
+      if (IS_SCREEN_ENABLED(ppu, screen, layer) &&
+          !(t->recorded[screen] & (1u << layer)))
+        supported = false;
+  const int left = -(int)ppu->extraLeftCur, right = 256 + ppu->extraRightCur;
+  uint8_t keep[kPpuBufWidth];
+  if (supported && t->policy) {
+    memset(keep, 0, sizeof(keep));
+    supported = t->policy(ppu, line, left, (unsigned)(right - left), keep,
+                          t->policy_context);
+  }
+  if (!supported) {
+    ++t->stats.native_lines;
+    return false;
+  }
+
+  uint8_t visibility[kPpuBufWidth] = {0};
+  PpuWindows window;
+  for (unsigned screen = 0; screen < 2; ++screen) {
+    if (!IS_SCREEN_ENABLED(ppu, screen, 4)) continue;
+    if (IS_SCREEN_WINDOWED(ppu, screen, 4))
+      PpuWindows_Calc(&window, ppu, 4, (int)line);
+    else
+      PpuWindows_Clear(&window, ppu, 4, (int)line);
+    PpuHdMarkWindow(visibility, &window, (uint8_t)(1u << screen), false);
+  }
+  PpuWindows_Calc(&window, ppu, 5, (int)line);
+  PpuHdMarkWindow(visibility, &window, 16, true);
+
+  const uint16_t *vram = PpuRenderVram(ppu);
+  const uint32_t *native = (const uint32_t *)(ppu->renderBuffer +
+      (line - 1) * ppu->renderPitch);
+  uint8_t *first = (uint8_t *)surface->pixels + (line - 1) * scale * surface->pitch;
+  const uint16_t stamp = t->stamp;
+  for (unsigned j = 0; j < width; ++j) {
+    const int x = (int)j - (int)ppu->extraLeftRight;
+    const uint32_t want = native[j];
+    PpuHdCandidate cand[2][kPpuHdSources];
+    unsigned count[2] = {0, 0};
+    bool composed = false;
+    if (x >= left && x < right && !(t->policy && keep[x - left])) {
+      const size_t i = (size_t)(x + kPpuExtraLeftRight);
+      bool any_image = false;
+      for (unsigned screen = 0; t->any[i] && screen < (sub_rendered ? 2u : 1u); ++screen) {
+        for (unsigned source = 0; source < kPpuHdSources; ++source) {
+          const PpuHdTileRecord *rec = source == kPpuHdObj ?
+              &t->records[0][kPpuHdObj][i] : &t->records[screen][source][i];
+          if (rec->stamp != stamp) continue;
+          if (source == kPpuHdObj && !(visibility[i] & (1u << screen))) continue;
+          PpuHdCandidate *c = &cand[screen][count[screen]++];
+          c->rec = rec;
+          c->image = rec->entry ? t->entries[rec->entry - 1].image : NULL;
+          any_image |= c->image != NULL;
+        }
+      }
+      /* Without an HD image the result is the native pixel; only a pixel we
+       * would replace needs the exactness check. */
+      bool valid = any_image;
+      for (unsigned screen = 0; valid && screen < 2; ++screen)
+        for (unsigned k = 0; k < count[screen]; ++k)
+          cand[screen][k].native_index = PpuHdNativeIndex(vram, cand[screen][k].rec);
+      uint16_t main = 0x0500, sub = 0x0500;
+      if (valid) {
+        /* OBJ pixels without a matching record came from elsewhere (host
+         * objects, overlays); keep them exact. */
+        const PpuHdTileRecord *obj = &t->records[0][kPpuHdObj][i];
+        uint16_t obj_value = obj->stamp == stamp ?
+            (uint16_t)(obj->z + PpuHdNativeIndex(vram, obj)) : 0x0500;
+        main = PpuHdResolveNative(cand[0], count[0]);
+        sub = sub_rendered ? PpuHdResolveNative(cand[1], count[1]) : 0x0500;
+        valid = ppu->objBuffer.data[i] == obj_value &&
+            main == ppu->bgBuffers[0].data[i] &&
+            (!sub_rendered || sub == ppu->bgBuffers[1].data[i]) &&
+            PpuHdColour(ppu, main, sub, (visibility[i] & 16) != 0, i) == want;
+        if (!valid) ++t->stats.fallback_pixels;
+      }
+      unsigned kind[2] = {kPpuHdResolveNative, kPpuHdResolveNative};
+      unsigned win[2] = {0, 0};
+      if (valid) {
+        ++t->stats.replaced_pixels;
+        kind[0] = PpuHdClassify(cand[0], count[0], &win[0]);
+        if (sub_rendered) kind[1] = PpuHdClassify(cand[1], count[1], &win[1]);
+        /* Every subpixel resolves to the validated native pair. */
+        if (kind[0] == kPpuHdResolveNative && kind[1] == kPpuHdResolveNative)
+          valid = false;
+      }
+      if (valid) {
+        const bool inside = (visibility[i] & 16) != 0;
+        /* Colour depends only on the resolved pair within one native pixel,
+         * and most subpixels resolve to the validated native pair. */
+        uint16_t last_m = main, last_b = sub;
+        uint32_t last_colour = want;
+        for (unsigned sy = 0; sy < scale; ++sy) {
+          uint32_t *row = (uint32_t *)(first + sy * surface->pitch) + j * scale;
+          PpuHdSelectSubrow(cand[0], count[0], scale, sy);
+          if (sub_rendered) PpuHdSelectSubrow(cand[1], count[1], scale, sy);
+          for (unsigned sx = 0; sx < scale; ++sx) {
+            uint16_t value[2] = {main, sub};
+            for (unsigned screen = 0; screen < 2; ++screen) {
+              const PpuHdCandidate *c = cand[screen];
+              if (kind[screen] == kPpuHdResolveFull) {
+                value[screen] = PpuHdResolveAt(c, count[screen], sx);
+              } else if (kind[screen] == kPpuHdResolveWinner) {
+                const PpuHdCandidate *w = &c[win[screen]];
+                value[screen] = (uint16_t)(w->rec->z + w->line[(int)sx * w->step]);
+              }
+            }
+            const uint16_t m = value[0], b = value[1];
+            if (m == main && b == sub) {
+              row[sx] = want;
+              continue;
+            }
+            if (m != last_m || b != last_b) {
+              last_m = m;
+              last_b = b;
+              last_colour = PpuHdColour(ppu, m, b, inside, i);
+            }
+            row[sx] = last_colour;
+          }
+        }
+        composed = true;
+      }
+    }
+    if (!composed)
+      for (unsigned sy = 0; sy < scale; ++sy) {
+        uint32_t *row = (uint32_t *)(first + sy * surface->pitch) + j * scale;
+        for (unsigned sx = 0; sx < scale; ++sx) row[sx] = want;
+      }
+  }
+  ++t->stats.hd_lines;
+  return true;
+}
