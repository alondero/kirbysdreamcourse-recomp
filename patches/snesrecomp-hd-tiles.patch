 // Draw a whole line of a 4bpp background layer into bgBuffers
+
+/* ---- HD tile replacement: records and cache ------------------------------
+ * While a tile source and an HD surface are bound, the Mode 1 8x8 drawers and
+ * OBJ evaluation record, for each native pixel, which character each source
+ * offered there (including its transparent pixels), with palette, priority
+ * and flips. The line pass after scanout resolves every HD subpixel from those
+ * records. Records are only trusted for layers drawn directly into the line's
+ * priority buffers; anything else keeps the native line. */
+enum { kPpuHdSources = 5, kPpuHdObj = 4,
+       kPpuHdFlipX = 1, kPpuHdFlipY = 2, kPpuHdBpp4 = 4,
+       kPpuHdCacheSlots = 16384 };
+typedef struct PpuHdTileRecord {
+  uint16_t address, z;      /* first character word; priority|layer|palette */
+  uint8_t col, row, flags;  /* unflipped character pixel; flips and depth */
+  uint8_t unused;
+  uint16_t stamp;           /* valid for the current line only */
+  uint16_t entry;           /* cache slot + 1 with an HD image, else 0 */
+} PpuHdTileRecord;
+/* One source image with per-texel summaries, bit (row * 8 + col) of the
+ * unflipped character: every subpixel opaque, every subpixel transparent, or
+ * every subpixel equal to the native pixel. They let the line pass skip
+ * per-subpixel priority resolution where the outcome is already known. */
+typedef struct PpuHdImage {
+  uint64_t opaque, clear, same;
+  uint8_t indices[];
+} PpuHdImage;
+typedef struct PpuHdTileEntry {
+  uint64_t hash;
+  PpuHdTileQuery key;
+  PpuHdImage *image;        /* NULL: the source kept this character native */
+  bool used;
+} PpuHdTileEntry;
+typedef struct PpuHdTileMemo {
+  uint16_t address, palette;
+  uint8_t bpp;
+  bool valid;
+  uint16_t entry;
+} PpuHdTileMemo;
+struct PpuHdTiles {
+  PpuHdTileFill *fill;
+  void *context;
+  PpuHdLinePolicy *policy;
+  void *policy_context;
+  unsigned scale;
+  uint16_t stamp;
+  uint8_t recorded[2];      /* BG layers drawn straight into bgBuffers[screen] */
+  bool recording;
+  unsigned count;
+  PpuHdTileStats stats;
+  PpuHdTileMemo memo[kPpuHdSources];
+  PpuHdTileEntry *entries;
+  uint8_t any[kPpuBufWidth]; /* some record at this pixel has an HD image */
+  PpuHdTileRecord records[2][kPpuHdSources][kPpuBufWidth];
+};
+
+static void PpuHdTilesClearCache(struct PpuHdTiles *t) {
+  for (unsigned i = 0; i < kPpuHdCacheSlots; ++i)
+    free(t->entries[i].image);
+  memset(t->entries, 0, sizeof(*t->entries) * kPpuHdCacheSlots);
+  memset(t->memo, 0, sizeof(t->memo));
+  t->count = 0;
+}
+
+static void PpuHdTilesFree(struct PpuHdTiles *t) {
+  if (!t) return;
+  if (t->entries) PpuHdTilesClearCache(t);
+  free(t->entries);
+  free(t);
+}
+
+bool PpuSetHdTiles(Ppu *ppu, PpuHdTileFill *fill, void *context) {
+  if (!ppu) return false;
+  if (!fill) {
+    PpuHdTilesFree(ppu->hdTiles);
+    ppu->hdTiles = NULL;
+    return true;
+  }
+  struct PpuHdTiles *t = ppu->hdTiles;
+  if (!t) {
+    t = calloc(1, sizeof(*t));
+    if (!t) return false;
+    t->entries = calloc(kPpuHdCacheSlots, sizeof(*t->entries));
+    if (!t->entries) { free(t); return false; }
+    ppu->hdTiles = t;
+  } else {
+    PpuHdTilesClearCache(t);
+  }
+  t->fill = fill;
+  t->context = context;
+  memset(&t->stats, 0, sizeof(t->stats));
+  return true;
+}
+
+bool PpuSetHdTilePolicy(Ppu *ppu, PpuHdLinePolicy *policy, void *context) {
+  if (!ppu || (!ppu->hdTiles && policy)) return false;
+  if (ppu->hdTiles) {
+    ppu->hdTiles->policy = policy;
+    ppu->hdTiles->policy_context = policy ? context : NULL;
+  }
+  return true;
+}
+
+void PpuInvalidateHdTiles(Ppu *ppu) {
+  if (ppu && ppu->hdTiles) PpuHdTilesClearCache(ppu->hdTiles);
+}
+
+void PpuGetHdTileStats(Ppu *ppu, PpuHdTileStats *stats) {
+  if (!stats) return;
+  memset(stats, 0, sizeof(*stats));
+  if (!ppu || !ppu->hdTiles) return;
+  *stats = ppu->hdTiles->stats;
+  stats->cached_tiles = ppu->hdTiles->count;
+}
+
+static void PpuHdTilesBeginLine(Ppu *ppu) {
+  struct PpuHdTiles *t = ppu->hdTiles;
+  if (!t) return;
+  const PpuMode7HdSurface *surface = &ppu->mode7Hd;
+  t->recording = surface->pixels && surface->scale > 1 &&
+      surface->scale <= kPpuHdTileMaxScale && PPU_mode(ppu) == 1;
+  if (!t->recording) return;
+  /* Cached images are scale-specific. Clear only between lines so a pointer
+   * fetched for this line cannot be freed while it is being sampled. */
+  if (t->scale != surface->scale || t->count >= kPpuHdCacheSlots * 3 / 4) {
+    PpuHdTilesClearCache(t);
+    t->scale = surface->scale;
+  }
+  memset(t->memo, 0, sizeof(t->memo));
+  memset(t->any, 0, sizeof(t->any));
+  t->recorded[0] = t->recorded[1] = 0;
+  if (++t->stamp == 0) {
+    memset(t->records, 0, sizeof(t->records));
+    t->stamp = 1;
+  }
+}
+
+static inline PpuHdTileRecord *PpuHdRecordRow(Ppu *ppu, unsigned screen,
+                                              unsigned source) {
+  struct PpuHdTiles *t = ppu->hdTiles;
+  return t && t->recording ? t->records[screen][source] : NULL;
+}
+
+static uint16_t PpuHdLookup(Ppu *ppu, unsigned source,
+                            const PpuHdTileRecord *rec);
+
+static inline void PpuHdRecordBgSpan(Ppu *ppu, PpuHdTileRecord *rec,
+                                     unsigned source,
+                                     size_t first, unsigned count,
+                                     uint32_t tile, unsigned raw_x,
+                                     unsigned raw_y, unsigned tileadr,
+                                     unsigned bpp, PpuZbufType zhi,
+                                     PpuZbufType zlo, unsigned palette_shift) {
+  const bool flip_x = (tile & 0x4000) != 0, flip_y = (tile & 0x8000) != 0;
+  PpuHdTileRecord value = {
+    (uint16_t)((tileadr + (tile & 0x3ff) * (bpp * 4)) & 0x7fff),
+    (uint16_t)(((tile & 0x2000) ? zhi : zlo) + ((tile & 0x1c00) >> palette_shift)),
+    0, (uint8_t)(flip_y ? 7 - (raw_y & 7) : (raw_y & 7)),
+    (uint8_t)((bpp == 4 ? kPpuHdBpp4 : 0) | (flip_x ? kPpuHdFlipX : 0) |
+              (flip_y ? kPpuHdFlipY : 0)),
+    0, ppu->hdTiles->stamp, 0
+  };
+  /* One lookup per character span; the cache is stable within a line. */
+  value.entry = PpuHdLookup(ppu, source, &value);
+  for (unsigned k = 0; k < count && first + k < kPpuBufWidth; ++k) {
+    unsigned raw = (raw_x + k) & 7;
+    value.col = (uint8_t)(flip_x ? 7 - raw : raw);
+    rec[first + k] = value;
+    if (value.entry) ppu->hdTiles->any[first + k] = 1;
+  }
+}
+
+static inline unsigned PpuHdNativeIndex(const uint16_t *vram,
+                                        const PpuHdTileRecord *rec) {
+  unsigned c = rec->col, r = rec->row;
+  unsigned w = vram[(rec->address + r) & 0x7fff];
+  unsigned v = (w >> (7 - c) & 1) | (w >> (15 - c) & 1) << 1;
+  if (rec->flags & kPpuHdBpp4) {
+    w = vram[(rec->address + 8 + r) & 0x7fff];
+    v |= (w >> (7 - c) & 1) << 2 | (w >> (15 - c) & 1) << 3;
+  }
+  return v;
+}
+
+static uint64_t PpuHdHash(const PpuHdTileQuery *q) {
+  /* Words and colours are 64 contiguous bytes; mix them a word at a time. */
+  uint64_t hash = 0x9e3779b97f4a7c15ull ^ q->bpp;
+  const uint8_t *bytes = (const uint8_t *)q->words;
+  for (size_t i = 0; i < sizeof(q->words) + sizeof(q->colors); i += 8) {
+    uint64_t word;
+    memcpy(&word, bytes + i, 8);
+    hash = (hash ^ word) * 0xff51afd7ed558ccdull;
+    hash ^= hash >> 32;
+  }
+  return hash;
+}
+
+static void PpuHdSummarise(const PpuHdTileQuery *q, PpuHdImage *image) {
+  const unsigned s = q->scale, side = 8 * s;
+  image->opaque = image->clear = image->same = 0;
+  for (unsigned r = 0; r < 8; ++r)
+    for (unsigned c = 0; c < 8; ++c) {
+      unsigned w = q->words[r];
+      unsigned native = (w >> (7 - c) & 1) | (w >> (15 - c) & 1) << 1;
+      if (q->bpp == 4) {
+        w = q->words[8 + r];
+        native |= (w >> (7 - c) & 1) << 2 | (w >> (15 - c) & 1) << 3;
+      }
+      bool opaque = true, clear = true, same = true;
+      for (unsigned y = 0; y < s; ++y)
+        for (unsigned x = 0; x < s; ++x) {
+          const uint8_t v = image->indices[(r * s + y) * side + c * s + x];
+          opaque &= v != 0;
+          clear &= v == 0;
+          same &= v == native;
+        }
+      const uint64_t bit = 1ull << (r * 8 + c);
+      if (opaque) image->opaque |= bit;
+      if (clear) image->clear |= bit;
+      if (same) image->same |= bit;
+    }
+}
+
+/* Content-addressed: the same character and colours share one image even
+ * when a game streams it through different VRAM slots. */
+static uint16_t PpuHdLookup(Ppu *ppu, unsigned source,
+                            const PpuHdTileRecord *rec) {
+  struct PpuHdTiles *t = ppu->hdTiles;
+  const unsigned bpp = (rec->flags & kPpuHdBpp4) ? 4 : 2;
+  const uint16_t palette = rec->z & 0xff;
+  PpuHdTileMemo *memo = &t->memo[source];
+  if (memo->valid && memo->address == rec->address &&
+      memo->palette == palette && memo->bpp == bpp)
+    return memo->entry;
+  PpuHdTileQuery q;
+  memset(&q, 0, sizeof(q));
+  const uint16_t *vram = PpuRenderVram(ppu);
+  for (unsigned i = 0; i < bpp * 4; ++i)
+    q.words[i] = vram[(rec->address + i) & 0x7fff];
+  for (unsigned i = 1; i < (1u << bpp); ++i)
+    q.colors[i] = ppu->cgram[(palette + i) & 0xff];
+  q.bpp = (uint8_t)bpp;
+  q.scale = (uint8_t)t->scale;
+  const uint64_t hash = PpuHdHash(&q);
+  const size_t key_bytes = offsetof(PpuHdTileQuery, scale);
+  unsigned slot = (unsigned)hash & (kPpuHdCacheSlots - 1);
+  uint16_t found = 0;
+  for (;;) {
+    PpuHdTileEntry *e = &t->entries[slot];
+    if (!e->used) {
+      if (t->count + 1 >= kPpuHdCacheSlots) break; /* full until next line */
+      const size_t bytes = sizeof(PpuHdImage) + (size_t)64 * t->scale * t->scale;
+      PpuHdImage *image = malloc(bytes);
+      if (image && !t->fill(&q, image->indices, t->context)) {
+        free(image);
+        image = NULL;
+      }
+      if (image) PpuHdSummarise(&q, image);
+      e->used = true;
+      e->hash = hash;
+      e->key = q;
+      e->image = image;
+      ++t->count;
+      found = image ? (uint16_t)(slot + 1) : 0;
+      break;
+    }
+    if (e->hash == hash && !memcmp(&e->key, &q, key_bytes)) {
+      found = e->image ? (uint16_t)(slot + 1) : 0;
+      break;
+    }
+    slot = (slot + 1) & (kPpuHdCacheSlots - 1);
+  }
+  *memo = (PpuHdTileMemo){rec->address, palette, (uint8_t)bpp, true, found};
+  return found;
+}
