+  uint32_t count, dropped;
+  PpuRasterSnapshotEntry entries[PPU_RASTER_SNAPSHOT_MAX];
+} PpuRasterSnapshotField;
+typedef struct {
+  uint32_t magic, version, armed, current, completed;
+  PpuRasterSnapshotField fields[2];
+} PpuRasterSnapshot;
+bool ppu_rasterSnapshotCapture(PpuRasterSnapshot *out);
+bool ppu_rasterSnapshotValidate(const PpuRasterSnapshot *in);
+void ppu_rasterSnapshotRestore(const PpuRasterSnapshot *in);
