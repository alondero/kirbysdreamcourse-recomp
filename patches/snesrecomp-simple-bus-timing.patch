+def _simple_master_lines(pairs, cycles: int):
+    """Experimental native-mode bus pricing for a small, closed opcode set.
+
+    Return None for any block whose bus accesses or address state can change
+    in ways this routine does not model. This is not a general timing model.
+    """
+    if not pairs:
+        return None
+    insns = [pair[0] for pair in pairs]
+    data = []
+    direct = []
+    stack = 0
+    stack_reads = 0
+    fetch = []
+    for index, insn in enumerate(insns):
+        if insn.opcode in (0xc2, 0xe2, 0xa9, 0xa2, 0xa0) and insn.mode == _MODE_IMM:
+            pass
+        elif insn.opcode in (0x8d, 0x9c, 0x8e, 0x8c, 0xad) and insn.mode == _MODE_ABS:
+            width = 1 if (insn.x_flag if insn.opcode in (0x8e, 0x8c) else insn.m_flag) else 2
+            # The interpreter carries absolute word accesses into the next bank;
+            # the generated cpu_read16/cpu_write16 helpers wrap within the bank.
+            # Until that semantic seam is resolved, do not compile the crossing.
+            if width == 2 and insn.operand == 0xffff:
+                return None
+            data.extend((insn.operand + offset) & 0xffff for offset in range(width))
+        elif insn.opcode in (0xa6, 0xe4) and insn.mode == _MODE_DP:
+            direct.extend(insn.operand + offset for offset in range(1 if insn.x_flag else 2))
+        elif insn.opcode in (0x10, 0x30, 0x50, 0x70, 0x90, 0xb0, 0xd0, 0xf0) and insn.mode == _MODE_REL and index == len(insns) - 1:
+            pass
+        elif insn.opcode == 0x22 and insn.mode == _MODE_LONG and index == len(insns) - 1:
+            stack = 3
+        elif insn.opcode in (0x60, 0x6b) and insn.mode == _MODE_IMP and index == len(insns) - 1:
+            stack_reads = 3 if insn.opcode == 0x6b else 2
+        else:
+            return None
+        fetch.extend((insn.addr + offset) & 0xffff for offset in range(insn.length))
+    internal = cycles - len(fetch) - len(data) - len(direct) - stack - stack_reads
+    if internal < 0:
+        return None
+    lines = [f'    cpu->master_cycles += {internal * 6}u;'] if internal else []
+    lines += [f'    cpu->master_cycles += cpu_region_speed(((uint32)cpu->PB << 16) | 0x{addr:04x}u);' for addr in fetch]
+    lines += [f'    cpu->master_cycles += cpu_region_speed(((uint32)cpu->DB << 16) | 0x{addr:04x}u);' for addr in data]
+    lines += [f'    cpu->master_cycles += cpu_region_speed((uint16)(cpu->D + 0x{addr:04x}u));' for addr in direct]
+    lines += [f'    cpu->master_cycles += cpu_region_speed((uint16)(cpu->S - {offset}u));' for offset in range(stack)]
+    lines += [f'    cpu->master_cycles += cpu_region_speed((uint16)(cpu->S + {offset}u));' for offset in range(1, stack_reads + 1)]
+    return lines
+
+
