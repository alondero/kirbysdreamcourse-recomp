index 0000000..8b1b89e
--- /dev/null
+++ b/tests/v2/test_simple_bus_timing.py
@@ -0,0 +1,267 @@
+"""Synthetic bus-clock checks for the opt-in simple block model."""
+import os
+import shutil
+import subprocess
+from types import SimpleNamespace
+
+import pytest
+from snes65816 import ABS, IMM, LONG
+from _helpers import make_lorom_bank0
+from v2.emit_function import _simple_master_lines, emit_function
+
+
+def insn(pc, name, mode, length, opcode, operand=0, m=0):
+    return SimpleNamespace(addr=pc, mnem=name, mode=mode, length=length,
+                           opcode=opcode, operand=operand, m_flag=m, x_flag=0)
+
+
+def test_fastrom_mixed_bus_and_native_stack(tmp_path):
+    # REP, LDA #imm16, STA $1fff, JSL: 19 CPU cycles. The 16-bit store
+    # crosses WRAM -> I/O; native stack crosses from $0100 to $00ff.
+    pairs = [(i, []) for i in [
+        insn(0x808000, 'REP', IMM, 2, 0xc2, 0x20, 1),
+        insn(0x808002, 'LDA', IMM, 3, 0xa9, 0x1234),
+        insn(0x808005, 'STA', ABS, 3, 0x8d, 0x1fff),
+        insn(0x808008, 'JSL', LONG, 4, 0x22, 0x818000),
+    ]]
+    lines = _simple_master_lines(pairs, 19)
+    assert lines is not None
+    compiler = shutil.which('gcc')
+    if not compiler:
+        pytest.skip('C compiler unavailable')
+    source = r'''
+#include <stdint.h>
+#include <assert.h>
+typedef uint32_t uint32; typedef uint16_t uint16;
+typedef struct { uint64_t master_cycles; uint8_t PB, DB, emulation; uint16_t S; } Cpu;
+static unsigned stack100, stackff, stackfe;
+static unsigned cpu_region_speed(uint32 a) {
+    if (a == 0x000100) ++stack100;
+    if (a == 0x0000ff) ++stackff;
+    if (a == 0x0000fe) ++stackfe;
+    if ((a & 0xff0000) == 0x800000) return 6; /* fast code */
+    if (a == 0x002000) return 6; /* I/O */
+    return 8; /* WRAM and stack */
+}
+static void charge(Cpu *cpu) {
+''' + '\n'.join(lines) + r'''
+}
+int main(void) {
+    Cpu fast = {0, 0x80, 0, 0, 0x0100};
+    charge(&fast);
+    assert(fast.master_cycles == 122); /* 12 fetch*6 + 2 internal*6 + 8+6 + 3*8 */
+    assert(stack100 == 1 && stackff == 1 && stackfe == 1);
+    Cpu slow = {0, 0, 0x7e, 0, 0x1fff};
+    charge(&slow);
+    assert(slow.master_cycles == 148); /* 12 fetch*8 + 2 internal*6 + 2*8 + 3*8 */
+    return 0;
+}
+'''
+    cfile = tmp_path / 'timing.c'
+    cfile.write_text(source, encoding='utf-8')
+    exe = tmp_path / ('timing.exe' if os.name == 'nt' else 'timing')
+    subprocess.run([compiler, '-std=c11', '-Wall', '-Wextra', '-Werror', str(cfile), '-o', str(exe)], check=True, capture_output=True)
+    subprocess.run([str(exe)], check=True, capture_output=True)
+
+
+def test_unsupported_instruction_declines_precise_charge():
+    # Indirect indexed load has dynamic data and pointer accesses; do not guess.
+    unknown = insn(0x808000, 'LDA', 17, 2, 0xb7, 0x20)
+    assert _simple_master_lines([(unknown, [])], 6) is None
+
+
+def test_store_width_and_word_wrap_are_explicit():
+    byte_store = insn(0x808000, 'STA', ABS, 3, 0x8d, 0xffff, 1)
+    word_store = insn(0x808000, 'STA', ABS, 3, 0x8d, 0xffff, 0)
+    byte_lines = '\n'.join(_simple_master_lines([(byte_store, [])], 4))
+    assert _simple_master_lines([(word_store, [])], 5) is None
+    assert '0xffffu' in byte_lines and '0x0000u' not in byte_lines
+
+
+def test_opt_in_emits_bus_model_and_preserves_emulation_fallback(monkeypatch):
+    # REP #$20; LDA #$1234; STA $1fff; JSL $808100
+    rom = make_lorom_bank0({0x8000: bytes([0xc2, 0x20, 0xa9, 0x34, 0x12,
+                                           0x8d, 0xff, 0x1f, 0x22, 0x00, 0x81, 0x80]),
+                            0x800c: bytes([0x60]), 0x8100: bytes([0x6b])})
+    monkeypatch.delenv('SNESRECOMP_EMIT_SIMPLE_BUS_TIMING', raising=False)
+    old = emit_function(rom, bank=0, start=0x8000, entry_m=1, entry_x=0)
+    monkeypatch.setenv('SNESRECOMP_EMIT_SIMPLE_BUS_TIMING', '1')
+    new = emit_function(rom, bank=0, start=0x8000, entry_m=1, entry_x=0)
+    assert 'cpu_region_speed(((uint32)cpu->DB << 16) | 0x1fffu)' not in old
+    assert 'cpu_region_speed(((uint32)cpu->DB << 16) | 0x1fffu)' in new
+    assert 'cpu_region_speed(((uint32)cpu->DB << 16) | 0x2000u)' in new
+    assert 'if (cpu->emulation' in new
+    assert 'cpu->DB != 0x7e && cpu->DB != 0x7f' in new
+    assert 'cpu->S < 2 || cpu->S > 0x1fff' in new
+
+
+def test_opt_in_tiers_unsupported_blocks_before_charging(monkeypatch):
+    # NOP is deliberately outside the model. It must execute in the interpreter.
+    rom = make_lorom_bank0({0x8000: bytes([0xea, 0x60])})
+    monkeypatch.setenv('SNESRECOMP_EMIT_SIMPLE_BUS_TIMING', '1')
+    source = emit_function(rom, bank=0, start=0x8000, entry_m=1, entry_x=1)
+    marker = 'cpu_trace_block(cpu, 0x008000);'
+    block = source[source.index(marker):]
+    dispatch = block.index('return interp_tier_dispatch_tail_ex(')
+    charge = block.index('cpu->cycles +=')
+    assert dispatch < charge
+    assert '0x008000u' in block[:charge]
+
+
+def test_opt_in_tiers_unsafe_runtime_state_before_charging(monkeypatch):
+    rom = make_lorom_bank0({0x8000: bytes([0x8d, 0xff, 0x1f, 0x22, 0x00, 0x81, 0x80]),
+                            0x8007: bytes([0x60]), 0x8100: bytes([0x6b])})
+    monkeypatch.setenv('SNESRECOMP_EMIT_SIMPLE_BUS_TIMING', '1')
+    source = emit_function(rom, bank=0, start=0x8000, entry_m=1, entry_x=1)
+    block = source[source.index('cpu_trace_block(cpu, 0x008000);'):]
+    dispatch = block.index('return interp_tier_dispatch_tail_ex(')
+    charge = block.index('cpu->cycles +=')
+    assert dispatch < charge
+    assert 'cpu->DB != 0x7e && cpu->DB != 0x7f' in block[:dispatch]
+
+
+def test_index_store_and_long_return_count_bus_accesses():
+    from snes65816 import IMP
+    pairs = [(i, []) for i in [
+        insn(0x808000, 'LDX', IMM, 3, 0xa2, 0x1234),
+        insn(0x808003, 'STX', ABS, 3, 0x8e, 0xfffe),
+        insn(0x808006, 'RTL', IMP, 1, 0x6b),
+    ]]
+    lines = _simple_master_lines(pairs, 14)
+    assert lines is not None
+    source = '\n'.join(lines)
+    assert '0xfffeu' in source and '0xffffu' in source
+    for offset in (1, 2, 3):
+        assert f'cpu->S + {offset}u' in source
+
+
+def test_index_store_width_uses_index_flag():
+    word = insn(0x808000, 'STX', ABS, 3, 0x8e, 0x1000, 1)
+    byte = insn(0x808000, 'STX', ABS, 3, 0x8e, 0x1000, 0)
+    word.x_flag = 0
+    byte.x_flag = 1
+    assert '0x1001u' in '\n'.join(_simple_master_lines([(word, [])], 5))
+    assert '0x1001u' not in '\n'.join(_simple_master_lines([(byte, [])], 4))
+
+
+def test_return_stack_range_and_store_bank_are_guarded(monkeypatch):
+    # LDX #$1234; STX $1234; RTL
+    rom = make_lorom_bank0({0x8000: bytes([0xa2, 0x34, 0x12,
+                                           0x8e, 0x34, 0x12, 0x6b])})
+    monkeypatch.setenv('SNESRECOMP_EMIT_SIMPLE_BUS_TIMING', '1')
+    source = emit_function(rom, bank=0, start=0x8000, entry_m=0, entry_x=0)
+    block = source[source.index('cpu_trace_block(cpu, 0x008000);'):]
+    guard = block[:block.index('cpu->cycles +=')]
+    assert 'cpu->DB != 0x7e && cpu->DB != 0x7f' in guard
+    assert 'cpu->S > 0x1ffc' in guard
+    assert 'interp_tier_dispatch_tail_ex' in guard
+
+
+def test_short_return_has_two_stack_reads():
+    from snes65816 import IMP
+    lines = '\n'.join(_simple_master_lines([(insn(0x808000, 'RTS', IMP, 1, 0x60), [])], 6))
+    assert 'cpu->S + 1u' in lines
+    assert 'cpu->S + 2u' in lines
+    assert 'cpu->S + 3u' not in lines
+
+
+def test_direct_page_reads_and_branch_timing(monkeypatch):
+    # LDX $2c; CPX $32; BCC to an RTS; both branch paths exist.
+    rom = make_lorom_bank0({0x8000: bytes([0xa6, 0x2c, 0xe4, 0x32, 0x90, 0x01, 0x60, 0x60])})
+    monkeypatch.setenv('SNESRECOMP_EMIT_SIMPLE_BUS_TIMING', '1')
+    source = emit_function(rom, bank=0, start=0x8000, entry_m=0, entry_x=0)
+    block = source[source.index('cpu_trace_block(cpu, 0x008000);'):]
+    guard = block[:block.index('cpu->cycles +=')]
+    assert 'cpu->D & 0xff' in guard
+    assert 'cpu->D > 0x1fcc' in guard
+    assert 'interp_tier_dispatch_tail_ex' in guard
+    assert 'cpu_region_speed((uint16)(cpu->D + 0x002cu))' in block
+    assert 'cpu_region_speed((uint16)(cpu->D + 0x0033u))' in block
+    assert 'cpu->cycles += 1; cpu->master_cycles += 6;' in block
+
+
+def test_direct_page_width_respects_index_flag():
+    from snes65816 import DP
+    i = insn(0x808000, 'LDX', DP, 2, 0xa6, 0xff, 1)
+    i.x_flag = 0
+    lines = _simple_master_lines([(i, [])], 4)
+    assert lines is not None
+    assert 'cpu->D + 0x0100u' in '\n'.join(lines)
+    i.x_flag = 1
+    lines = _simple_master_lines([(i, [])], 3)
+    assert 'cpu->D + 0x0100u' not in '\n'.join(lines)
+
+
+def test_direct_page_block_clock_arithmetic(tmp_path):
+    from snes65816 import DP, REL
+    pairs = [(i, []) for i in [
+        insn(0x808000, 'LDX', DP, 2, 0xa6, 0x2c),
+        insn(0x808002, 'CPX', DP, 2, 0xe4, 0x32),
+        insn(0x808004, 'BCC', REL, 2, 0x90, 0x04),
+    ]]
+    lines = _simple_master_lines(pairs, 10)
+    assert lines is not None
+    compiler = shutil.which('gcc')
+    if not compiler:
+        pytest.skip('C compiler unavailable')
+    source = r'''
+#include <stdint.h>
+#include <assert.h>
+typedef uint32_t uint32; typedef uint16_t uint16;
+typedef struct { uint64_t master_cycles; uint8_t PB, DB; uint16_t D, S; } Cpu;
+static unsigned cpu_region_speed(uint32 a) { return (a & 0xff0000) == 0x800000 ? 6 : 8; }
+int main(void) {
+    Cpu state = {0, 0x80, 0, 0x1f00, 0}; Cpu *cpu = &state;
+''' + '\n'.join(lines) + r'''
+    assert(state.master_cycles == 68); /* six fast fetches + four WRAM reads */
+    return 0;
+}
+'''
+    cfile = tmp_path / 'dp.c'
+    cfile.write_text(source, encoding='utf-8')
+    exe = tmp_path / ('dp.exe' if os.name == 'nt' else 'dp')
+    subprocess.run([compiler, '-std=c11', '-Wall', '-Wextra', '-Werror', str(cfile), '-o', str(exe)], check=True, capture_output=True)
+    subprocess.run([str(exe)], check=True, capture_output=True)
+
+
+def test_absolute_load_reads_accumulator_width_and_wrap():
+    byte = insn(0x808000, 'LDA', ABS, 3, 0xad, 0xffff, 1)
+    word = insn(0x808000, 'LDA', ABS, 3, 0xad, 0xffff, 0)
+    byte.x_flag = 0
+    word.x_flag = 1
+    b = _simple_master_lines([(byte, [])], 4)
+    w = _simple_master_lines([(word, [])], 5)
+    assert b is not None and w is None
+    assert '0x0000u' not in '\n'.join(b)
+
+
+def test_absolute_load_requires_wram_bank_and_native_mode(monkeypatch):
