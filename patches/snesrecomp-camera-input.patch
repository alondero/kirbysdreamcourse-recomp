+int snesrecomp_desktop_input_active(void) {
+  return g_window && !g_paused && !g_overlay_modal &&
+         snesrecomp_host_frame_is_live() &&
+         (SDL_GetWindowFlags(g_window) & SDL_WINDOW_INPUT_FOCUS) != 0;
+}
+
+int snesrecomp_desktop_analog_input(int seat, SnesDesktopAnalogInput *out) {
+  if (!out) return 0;
+  memset(out, 0, sizeof(*out));
+  if (seat < 0 || seat >= HostConfiguredSeats() ||
+      !snesrecomp_desktop_input_active() || !g_config.enable_gamepad[seat] ||
+      (ConfigHasPlayerSource(seat) && g_config.player_src[seat] != 2)) return 0;
+  GamepadInfo *gi = &g_gamepad[seat];
+  if (gi->joystick_id == (SDL_JoystickID)-1) return 0;
+  if (gi->analog_blocked) {
+    int deadzone = g_config.gamepad_deadzone;
+    if (deadzone < 4000) deadzone = 4000;
+    if (abs(gi->right_axis_x) > deadzone || abs(gi->right_axis_y) > deadzone ||
+        (gi->modifiers & (1u << kGamepadBtn_R3))) return 0;
+    gi->analog_blocked = false;
+  }
+  out->right_x = gi->right_axis_x;
+  out->right_y = gi->right_axis_y;
+  out->right_stick = (gi->modifiers & (1u << kGamepadBtn_R3)) != 0 &&
+                     !gi->last_cmd[kGamepadBtn_R3];
+  return 1;
+}
