diff --git a/runner/src/common_rtl.c b/runner/src/common_rtl.c
index e101618..aa98603 100644
--- a/runner/src/common_rtl.c
+++ b/runner/src/common_rtl.c
@@ -1336,6 +1336,23 @@ void RtlSaveExecutionState(SaveLoadInfo *sli) {
   cx4_saveload_clock(g_snes->cart->cx4, sli);
 }
 
+size_t RtlValidateExecutionState(const void *data, size_t size) {
+  const size_t clock_size = g_snes && g_snes->cart && g_snes->cart->cx4
+                                ? sizeof(uint64_t) : 0;
+  const size_t needed = sizeof(uint32) + sizeof(RtlRollbackResidue) + clock_size;
+  if (!data || size < needed) return 0;
+  const uint8 *bytes = (const uint8 *)data;
+  uint32 header[3];
+  memcpy(header, bytes, sizeof(header));
+  if (header[0] != sizeof(RtlRollbackResidue) ||
+      header[1] != RTL_RB_RESIDUE_MAGIC || header[2] != RTL_RB_RESIDUE_VERSION)
+    return 0;
+  if (!interp_bridge_rb_state_valid(bytes + sizeof(uint32) +
+                                    offsetof(RtlRollbackResidue, interp)))
+    return 0;
+  return needed;
+}
+
 bool RtlLoadExecutionState(SaveLoadInfo *sli) {
   uint32 size = 0;
   s_loaded_execution_valid = false;
@@ -1522,10 +1539,13 @@ void RtlSaveLoad(int cmd, int slot) {
    * needs to distinguish them without the user remembering. */
   host_report_breadcrumb("savestate %s: %s",
       cmd == kSaveLoad_Save ? "save" : "load", name);
-  if (cmd == kSaveLoad_Save)
-    RtlSaveSnapshot(name);
-  else
-    RtlLoadSnapshot(name);
+  if (cmd == kSaveLoad_Save) {
+    if (!RtlSaveSnapshot(name))
+      fprintf(stderr, "Failed to save state: %s\n", name);
+  } else {
+    if (!RtlLoadSnapshot(name))
+      fprintf(stderr, "Failed to load state: %s\n", name);
+  }
 }
 
 
