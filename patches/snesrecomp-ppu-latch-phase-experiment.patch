@@ -207,6 +207,14 @@ uint64_t interp_bridge_bus_master(const CpuState *cpu) {
     return cpu->master_cycles + (s_interp_bus_timing_active ? s_interp_bus_master : 0);
 }
 
+/* Start of the current read's bus access. Snes9x samples the register
+ * before charging the access; outside the interpreter use the owning clock. */
+uint64_t interp_bridge_bus_sample_master(const CpuState *cpu, uint32_t address) {
+    if (!s_interp_bus_timing_active) return cpu->master_cycles;
+    uint32_t speed = bridge_region_speed(address);
+    return cpu->master_cycles + (s_interp_bus_master >= speed ? s_interp_bus_master - speed : 0);
+}
+
 static void bridge_timing_bus(uint32_t adr) {
     if (!s_interp_bus_timing_active) return;
     s_interp_bus_cycles++;
