+
+/* Opt-in beam hosts advance parked time themselves, including partial fields. */
+static inline uint64_t rtl_apu_clock_finish_elapsed(RtlApuFrameClock *clock,
+                                                   uint64_t master) {
+  uint64_t end = rtl_apu_clock_now(clock, master);
+  clock->last_duration = end - clock->start_guest;
+  clock->next_guest = end;
+  return end;
+}
