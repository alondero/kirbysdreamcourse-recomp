+  run_interrupt_timed(true, s_interrupt_handler_deadline);
+  g_snes->inNmi = was_nmi;
+  s_resume_pc = previous_resume;
+  s_handler_hdma_event = next_hdma_event(&s_handler_hdma_init);
+  interp_bridge_set_master_deadline(s_interrupt_handler_deadline);
+  interp_bridge_set_interrupt_boundary_hook(handler_hdma_boundary);
+  interp_bridge_set_interrupt_event_hook(handler_nmi_event);
 }
 
