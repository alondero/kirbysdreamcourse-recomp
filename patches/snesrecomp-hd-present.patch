+/* ---- Optional HD presentation surface -----------------------------------
+ * Bound for the next simulated frame in PreparePpuFrame and presented only
+ * after a whole frame has been drawn into it. The native field stays the
+ * authority for thumbnails, dumps, the overlay backdrop and a game-composed
+ * frame, which is nearest-scaled. */
+static uint32_t *g_hd_surface;
+static size_t g_hd_capacity;
+static unsigned g_hd_bound_scale, g_hd_bound_w, g_hd_bound_h;
+static uint32_t g_hd_bind_frame;
+static uint8_t *g_hd_native;
+
+static void HdUnbind(void) {
+  if (g_hd_bound_scale && g_ppu)
+    PpuBindMode7HdSurface(g_ppu, NULL, 0, 0, 0, 0, 0);
+  g_hd_bound_scale = 0;
+}
+
+static void HdBindForNextFrame(unsigned width, unsigned height) {
+  unsigned scale = g_game->hd_scale ? g_game->hd_scale() : 1;
+  if (scale > 4) scale = 4;
+  /* Only ports whose PPU field is the presented frame. */
+  if (scale < 2 || !g_ppu || (g_ws_active && !g_game->native_widescreen)) {
+    HdUnbind();
+    return;
+  }
+  if (g_hd_bound_scale == scale && g_hd_bound_w == width && g_hd_bound_h == height)
+    return;
+  const size_t pitch = (size_t)width * scale * 4u;
+  const size_t capacity = pitch * height * scale;
+  if (capacity > g_hd_capacity) {
+    HdUnbind();
+    free(g_hd_surface);
+    g_hd_surface = (uint32_t *)calloc(1, capacity);
+    g_hd_capacity = g_hd_surface ? capacity : 0;
+  }
+  if (!g_hd_native)
+    g_hd_native = (uint8_t *)malloc((size_t)kSnesDesktopMaxFrameWidth * 4u * 240u);
+  if (!g_hd_surface || !g_hd_native ||
+      !PpuBindMode7HdSurface(g_ppu, g_hd_surface, g_hd_capacity, pitch,
+                             width, height, scale)) {
+    HdUnbind();
+    return;
+  }
+  g_hd_bound_scale = scale;
+  g_hd_bound_w = width;
+  g_hd_bound_h = height;
+  g_hd_bind_frame = (uint32_t)snes_frame_counter;
+}
+
+/* The scale of the frame about to be presented: the binding must predate it. */
+static int HdPresentScale(void) {
+  if (!g_hd_bound_scale || g_hd_bound_w != (unsigned)g_snes_width ||
+      g_hd_bound_h != (unsigned)g_snes_height ||
+      (uint32_t)snes_frame_counter == g_hd_bind_frame)
+    return 1;
+  return (int)g_hd_bound_scale;
+}
+
+static void HdDrawFrame(uint8 *dst, size_t pitch, int scale) {
+  const int w = g_snes_width, h = g_snes_height;
+  const size_t native_pitch = (size_t)w * 4u;
+  bool composed = g_game->draw_frame &&
+      g_game->draw_frame(g_hd_native, native_pitch, g_my_pixels, w, h,
+                         g_present_alpha);
+  debug_server_note_composed_frame(composed ? g_hd_native : NULL,
+                                   composed ? (unsigned)native_pitch : 0,
+                                   composed ? w : 0, composed ? h : 0);
+  if (!composed)
+    RtlWidescreenPresent(g_hd_native, native_pitch, g_my_pixels, w, h);
+  const size_t row_bytes = (size_t)w * (size_t)scale * 4u;
+  for (int y = 0; y < h * scale; y++) {
+    uint32_t *out = (uint32_t *)(dst + (size_t)y * pitch);
+    if (composed) {
+      const uint32_t *in = (const uint32_t *)(g_hd_native + (size_t)(y / scale) * native_pitch);
+      for (int x = 0; x < w * scale; x++) out[x] = in[x / scale];
+    } else {
+      memcpy(out, (const uint8_t *)g_hd_surface + (size_t)y * row_bytes, row_bytes);
+    }
+  }
+}
