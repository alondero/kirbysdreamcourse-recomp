+uint16_t WsShadowResolveTile8x8(int layerIndex, int screenX, uint32_t wrappedY,
+                               uint16_t hScroll, uint16_t mapWordAdr,
+                               uint16_t realTile) {
+  if (WsShadowHasTileProvider(layerIndex)) {
+    int chunkPixels = 8 - (((unsigned)hScroll + (unsigned)screenX) & 7);
+    if (screenX < 256 && screenX + chunkPixels > 0)
+      return realTile;
+    return s_tileProvider(layerIndex, screenX, wrappedY, hScroll,
+                          realTile, s_tileProviderContext);
+  }
+  return WsShadowTile(layerIndex, screenX, wrappedY, hScroll, mapWordAdr, realTile);
+}
