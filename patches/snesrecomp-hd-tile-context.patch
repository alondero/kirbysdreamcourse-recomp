+/* Neighbour evidence follows the same tilemap/provider as the native BG.
+ * Store indices in the centre tile's unflipped coordinate system. A different
+ * palette or transparent neighbour cannot establish an opaque geometric edge. */
+static void PpuHdBorder(Ppu *ppu, unsigned layer, const PpuHdTileRecord *rec,
+                         unsigned raw_x, unsigned raw_y, uint8_t border[80]) {
+  const uint16_t *vram = PpuRenderVram(ppu);
+  const int ox = (int)(raw_x & ~7u), oy = (int)(raw_y & ~7u);
+  uint32_t neighbours[9];
+  const bool provider = WsShadowLayerActive(layer) || WsShadowHasTileProvider(layer);
+  /* Resolve each neighbouring character once, not once per border pixel. */
+  for (int row = 0; row < 3; ++row)
+    for (int column = 0; column < 3; ++column) {
+      int x = ox + (column - 1) * 8, y = oy + (row - 1) * 8;
+      unsigned mx = (unsigned)x, my = (unsigned)y;
+      unsigned address = PPU_bgTilemapAdr(ppu, layer) + ((my >> 3 & 31) * 32) + (mx >> 3 & 31);
+      if ((mx & 256) && PPU_bgTilemapWider(ppu, layer)) address += 0x400;
+      if ((my & 256) && PPU_bgTilemapHigher(ppu, layer))
+        address += PPU_bgTilemapWider(ppu, layer) ? 0x800 : 0x400;
+      address &= 0x7fff;
+      uint32_t tile = vram[address];
+      if (provider)
+        tile = WsShadowResolveTile8x8(layer, x - (int)ppu->hScroll[layer], my,
+            (uint16_t)ppu->hScroll[layer], (uint16_t)address, (uint16_t)tile);
+      neighbours[row * 3 + column] = tile;
+    }
+  uint16_t key[137];
+  key[0] = (uint16_t)((rec->z & 0xff) | ((rec->flags & 3) << 8));
+  unsigned at_key = 1;
+  for (unsigned i = 0; i < 9; ++i) {
+    if (i == 4) continue; /* the border never samples the centre character */
+    uint32_t tile = neighbours[i];
+    key[at_key++] = (uint16_t)(tile & 0xdc00);
+    unsigned at = (PPU_bgTileAdr(ppu, layer) + (tile & 1023) * 16) & 0x7fff;
+    memcpy(key + at_key, vram + at, 32); /* 16-word aligned; cannot wrap */
+    at_key += 16;
+  }
+  uint32_t hash = 2166136261u;
+  for (unsigned i = 0; i < 137; ++i) hash = (hash ^ key[i]) * 16777619u;
+  hash = (hash ^ (hash >> 16)) * 0x7feb352du;
+  hash ^= hash >> 15;
+  unsigned slot = hash & 511;
+  struct PpuHdTiles *tiles = ppu->hdTiles;
+  if (tiles->borders[slot].valid && !memcmp(tiles->borders[slot].key, key, sizeof(key))) {
+    memcpy(border, tiles->borders[slot].border, 80);
+    return;
+  }
+  for (int k = 0; k < 80; ++k) {
+    int x, y;
+    if (k < 48) {
+      int row = k / 12;
+      x = k % 12 - 2; y = row < 2 ? row - 2 : row + 6;
+    } else {
+      int column = (k - 48) / 8;
+      x = column < 2 ? column - 2 : column + 6; y = (k - 48) % 8;
+    }
+    if (rec->flags & kPpuHdFlipX) x = 7 - x;
+    if (rec->flags & kPpuHdFlipY) y = 7 - y;
+    unsigned column = x < 0 ? 0 : x >= 8 ? 2 : 1;
+    unsigned row = y < 0 ? 0 : y >= 8 ? 2 : 1;
+    uint32_t tile = neighbours[row * 3 + column];
+    if (((tile >> 10 & 7) * 16) != (rec->z & 0xff)) { border[k] = 0; continue; }
+    unsigned tx = (unsigned)x & 7, ty = (unsigned)y & 7;
+    if (tile & 0x4000) tx = 7 - tx;
+    if (tile & 0x8000) ty = 7 - ty;
+    unsigned at = (PPU_bgTileAdr(ppu, layer) + (tile & 1023) * 16 + ty) & 0x7fff;
+    unsigned a = vram[at], b = vram[(at + 8) & 0x7fff], shift = 7 - tx;
+    border[k] = (uint8_t)((a >> shift & 1) | (a >> (shift + 7) & 2) |
+                         (b >> shift & 1) << 2 | (b >> (shift + 7) & 2) << 2);
+  }
+  memcpy(tiles->borders[slot].key, key, sizeof(key));
+  memcpy(tiles->borders[slot].border, border, 80);
+  tiles->borders[slot].valid = true;
+}
