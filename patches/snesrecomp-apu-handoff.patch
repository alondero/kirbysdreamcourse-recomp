diff --git a/runner/src/snes/interp_bridge.c b/runner/src/snes/interp_bridge.c
index 98fb3b6..76b17d2 100644
--- a/runner/src/snes/interp_bridge.c
+++ b/runner/src/snes/interp_bridge.c
@@ -2871,8 +2871,16 @@ static int _interp_run_core(CpuState *cpu, uint32_t entry_pc24,
                  * time is dropped — only deferred to the next real flush. (No-op
                  * under SNES_COSIM_APU_SHARED: pending never accumulates there, so
                  * the co-sim gates are unaffected.) */
-                if (s_apu_pending_master >= bridge_bounce_flush_thresh())
+                const char *_handoff_opt = getenv("SNESRECOMP_APU_HANDOFF");
+                int _handoff = _handoff_opt && _handoff_opt[0] && _handoff_opt[0] != '0';
+#ifdef SNES_COSIM
+                if (cosim_apu_shared_clock()) _handoff = 0;
+#endif
+                if (_handoff || s_apu_pending_master >= bridge_bounce_flush_thresh())
                     bridge_apu_flush(cpu);
+                const uint64_t _handoff_start = cpu->master_cycles;
+                const uint64_t _handoff_sync = g_apu_last_sync_master;
+                const uint64_t _handoff_touches = g_apu_pace_cycles_estimate;
                 int _apu_drv = g_interp_apu_driving;
                 g_interp_apu_driving = 0;
                 int _saved_bounce_base = s_interp_bounce_recomp_base;
@@ -2889,6 +2897,15 @@ static int _interp_run_core(CpuState *cpu, uint32_t entry_pc24,
                                  (uint16_t)_sp_pre);
                 g_interp_wlog_pc24 = 0;
                 RecompReturn _air = cpu_dispatch_pc_paired(cpu, target, _fs);
+                /* Only credit an interval whose time was not already consumed
+                 * by a port touch or a nested interpreter flush. Other cases
+                 * retain the old policy until their clocks are qualified. */
+                if (_handoff && _handoff_sync == _handoff_start &&
+                    g_apu_last_sync_master == _handoff_sync &&
+                    g_apu_pace_cycles_estimate == _handoff_touches &&
+                    cpu->master_cycles >= _handoff_start &&
+                    cpu->master_cycles - _handoff_start >= s_apu_pending_master)
+                    s_apu_pending_master = cpu->master_cycles - _handoff_start;
                 s_interp_bounce_owner_depth = _saved_bounce_owner;
                 s_interp_bounce_recomp_base = _saved_bounce_base;
                 g_interp_apu_driving = _apu_drv;
