+      (apu->cpuCyclesLeft == 0x85 && (apu->pad[0] == 0xfa || apu->pad[0] == 0xba || apu->pad[0] == 0x78)) ||
+      (apu->cpuCyclesLeft == 0x83 && apu->pad[0] != 0xfa && apu->pad[0] != 0x69 && apu->pad[0] != 0xba && apu->pad[0] != 0x78))
