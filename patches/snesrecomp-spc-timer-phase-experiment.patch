+  if (apu->cpuCyclesLeft == 0x82 && apu->pad[0] == 0xba)
+    apu->spc->a = apu_cpuRead(apu, apu->pad[1] | (apu->spc->p ? 0x100 : 0));
+  if (apu->cpuCyclesLeft == 0x81 && apu->pad[0] == 0x69) {
+    uint8_t destination = apu_cpuRead(apu, apu->pad[3] | (apu->spc->p ? 0x100 : 0));
+    unsigned result = destination + (apu->pad[2] ^ 0xffu) + 1u;
+    apu->spc->c = result > 0xff;
+    apu->spc->z = (uint8_t)result == 0;
+    apu->spc->n = (result & 0x80) != 0;
+  }
+  if (apu->cpuCyclesLeft == 0x81 && apu->pad[0] == 0x78) {
+    uint8_t destination = apu_cpuRead(apu, apu->pad[3] | (apu->spc->p ? 0x100 : 0));
+    unsigned result = destination + (apu->pad[1] ^ 0xffu) + 1u;
+    apu->spc->c = result > 0xff;
+    apu->spc->z = (uint8_t)result == 0;
+    apu->spc->n = (result & 0x80) != 0;
+  }
+  if (apu->cpuCyclesLeft == 0x80) {
