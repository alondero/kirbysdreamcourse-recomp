+      apu->spc->y = apu_cpuRead(apu, address);
+      apu->spc->z = apu->spc->a == 0 && apu->spc->y == 0;
+      apu->spc->n = (apu->spc->y & 0x80) != 0;
+    } else if (apu->pad[0] == 0x7e) {
+      uint8_t value = apu_cpuRead(apu, apu->pad[1] | (apu->spc->p ? 0x100 : 0));
+      unsigned result = apu->spc->y + (value ^ 0xffu) + 1u;
+      apu->spc->c = result > 0xff;
+      apu->spc->z = (uint8_t)result == 0;
+      apu->spc->n = (result & 0x80) != 0;
+    } else if (apu->pad[0] != 0x69 && apu->pad[0] != 0x78) {
+      uint8_t value = apu_cpuRead(apu, apu->pad[1] | (apu->spc->p ? 0x100 : 0));
+      if (apu->pad[0] == 0xe4) apu->spc->a = value;
+      else apu->spc->y = value;
+      apu->spc->z = value == 0;
+      apu->spc->n = (value & 0x80) != 0;
+    }
+    apu->cpuCyclesLeft = 0;
+  }
   apu->cycles++;
   apu->portClock++;
 }
