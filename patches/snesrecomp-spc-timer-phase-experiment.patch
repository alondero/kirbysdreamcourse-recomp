+/* Local experiment: phase direct-page loads and memory moves.
+ * Pending state uses serialized padding and a high-bit marker; it is NOT
+ * save-format compatible with the unmodified runtime. */
+static bool kdc_code_safe(uint16_t address) {
+  return address < 0x00f0 || address > 0x00ff;
+}
+static bool kdc_timed_dp_instruction(const Apu *apu) {
+  uint16_t pc = apu->spc->pc;
+  if (apu->spc->stopped || !kdc_code_safe(pc)) return false;
+  uint8_t opcode = apu_cpuRead((Apu *)apu, pc);
+  unsigned length = (opcode == 0xfa || opcode == 0x69 || opcode == 0x78) ? 3 : 2;
+  if (opcode != 0xe4 && opcode != 0xeb && opcode != 0xfa && opcode != 0x69 &&
+      opcode != 0xba && opcode != 0x78 && opcode != 0x7e) return false;
+  for (unsigned i = 1; i < length; i++)
+    if (!kdc_code_safe((uint16_t)(pc + i))) return false;
+  return true;
+}
+
 void apu_cycle(Apu* apu) {
   apu_drainPortQueue(apu);
+  if (apu->cpuCyclesLeft == 0 && kdc_timed_dp_instruction(apu)) {
+    apu->pad[0] = apu_cpuRead(apu, apu->spc->pc);
+    apu->cpuCyclesLeft = apu->pad[0] == 0x69 ? 0x86 : (apu->pad[0] == 0xfa || apu->pad[0] == 0xba || apu->pad[0] == 0x78) ? 0x85 : 0x83;
+  }
   if(apu->cpuCyclesLeft == 0) {
     /* Sample PC right BEFORE running the opcode — so PC reflects the
      * instruction we're about to execute, not the post-opcode PC. */
@@ -259,6 +281,18 @@ void apu_cycle(Apu* apu) {
 #endif
