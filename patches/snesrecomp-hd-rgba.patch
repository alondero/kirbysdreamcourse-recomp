+/* Resolve the small source stack back-to-front at an RGBA subpixel.
+ * Window masks and native evidence were validated by the caller. */
+static uint32_t PpuHdExpand(unsigned bgr) {
+  unsigned rgb = ((bgr & 31) << 19) | ((bgr & 992) << 6) | ((bgr >> 10 & 31) << 3);
+  return rgb | ((rgb >> 5) & 0x070707);
+}
+
+static uint32_t PpuHdRgbMath(const Ppu *p, uint32_t rgb, unsigned layer,
+                             uint32_t other, bool sub_pixel, bool inside) {
+  if (PpuHdWindowCondition(PPU_clipMode(p), inside)) rgb = 0;
+  if (!(PPU_mathEnabled(p) & (1u << layer)) ||
+      PpuHdWindowCondition(PPU_preventMathMode(p), inside)) return rgb;
+  uint32_t result = 0;
+  for (int shift = 0; shift <= 16; shift += 8) {
+    int a = (rgb >> shift) & 255, b = (other >> shift) & 255;
+    a += PPU_subtractColor(p) ? -b : b;
+    if (PPU_halfColor(p) && (!PPU_addSubscreen(p) || sub_pixel)) a /= 2;
+    result |= (uint32_t)(a < 0 ? 0 : a > 255 ? 255 : a) << shift;
+  }
+  return result;
+}
+
+static uint32_t PpuHdPaintScreen(Ppu *p, const PpuHdCandidate *c, unsigned count,
+    unsigned sx, size_t x, bool main, bool inside, uint32_t other, bool *sub_pixel) {
+  struct Sample { uint16_t z; uint32_t ink; } stack[kPpuHdSources];
+  unsigned used = 0;
+  for (unsigned k = 0; k < count; ++k) {
+    const int offset = (int)sx * c[k].step;
+    uint16_t z = c[k].rec->z;
+    uint32_t ink;
+    if (c[k].image && c[k].image->rgba) {
+      size_t pos = (size_t)(c[k].line - c[k].image->indices + offset);
+      memcpy(&ink, c[k].image->indices + pos * sizeof(ink), sizeof(ink));
+      if (!(ink >> 24)) continue;
+      ++z;
+    } else {
+      unsigned index = c[k].line ? c[k].line[offset] : c[k].native_index;
+      if (!index) continue;
+      z += index;
+      ink = 0xff000000u | PpuHdExpand(PpuPixelColor(p,z,x));
+    }
+    unsigned j = used++;
+    while (j && stack[j - 1].z > z) { stack[j] = stack[j - 1]; --j; }
+    stack[j] = (struct Sample){z, ink};
+  }
+  uint32_t result = main ? PpuHdExpand(PpuPixelColor(p,0x0500,x)) : PpuHdExpand(p->fixedColor);
+  if (main) result = PpuHdRgbMath(p, result, 5, other, *sub_pixel, inside);
+  else *sub_pixel = used != 0;
+  for (unsigned k = 0; k < used; ++k) {
+    unsigned a = stack[k].ink >> 24;
+    uint32_t rgb = stack[k].ink & 0xffffff;
+    if (main) rgb = PpuHdRgbMath(p, rgb, (stack[k].z >> 8) & 15, other, *sub_pixel, inside);
+    if (a == 255) { result = rgb; continue; }
+    uint32_t mixed = 0;
+    for (int shift = 0; shift <= 16; shift += 8)
+      mixed |= ((((rgb >> shift & 255) * a + (result >> shift & 255) * (255-a) + 127) / 255) << shift);
+    result = mixed;
+  }
+  return result;
+}
