+#ifdef __ANDROID__
+// Keep taps and horizontal control drags, and let vertical swipes scroll the
+// settings cards. Delay touch clicks until the gesture's direction is known.
+struct LauncherTouch {
+    SDL_Event down{};
+    float last_y = 0.0f;
+    bool scrolling = false;
+
+    void press() const {
+        // SDL can omit motion when a tap repeats at the same screen position.
+        // A newly opened launcher still needs that position for hit-testing.
+        ImGuiIO& io = ImGui::GetIO();
+        io.AddMouseSourceEvent(ImGuiMouseSource_TouchScreen);
+        io.AddMousePosEvent(down.button.x, down.button.y);
+        LNG_ImplSDL_ProcessEvent(&down);
+    }
+
+    bool process(const SDL_Event& ev) {
+        if (ev.type == SDL_EVENT_MOUSE_BUTTON_DOWN && ev.button.which == SDL_TOUCH_MOUSEID) {
+            down = ev;
+            scrolling = false;
+            return true;
+        }
+        if (ev.type == SDL_EVENT_MOUSE_BUTTON_UP && ev.button.which == SDL_TOUCH_MOUSEID) {
+            if (down.type) press();
+            down.type = 0;
+            const bool consumed = scrolling;
+            scrolling = false;
+            return consumed;
+        }
+        if (ev.type != SDL_EVENT_MOUSE_MOTION || ev.motion.which != SDL_TOUCH_MOUSEID)
+            return false;
+        if (down.type) {
+            const float dx = std::abs(ev.motion.x - down.button.x);
+            const float dy = std::abs(ev.motion.y - down.button.y);
+            if (dx < 8.0f && dy < 8.0f) return false;
+            scrolling = dy > dx;
+            last_y = down.button.y;
+            if (!scrolling) press();
+            down.type = 0;
+        }
+        if (scrolling) {
+            ImGuiIO& io = ImGui::GetIO();
+            io.AddMouseSourceEvent(ImGuiMouseSource_TouchScreen);
+            io.AddMouseWheelEvent(0.0f, (ev.motion.y - last_y) / 80.0f);
+            last_y = ev.motion.y;
+        }
+        return false;
+    }
+};
+#endif
