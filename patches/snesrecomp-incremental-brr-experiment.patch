+/* Experimental four-sample BRR decoding in playback order. */
+static void dsp_decodeFour(Dsp *dsp, int ch) {
+  DspChannel *v = &dsp->channel[ch];
+  uint8_t header = dsp->apu_ram[v->brrAddress];
+  int shift = header >> 4, filter = (header >> 2) & 3;
+  int older = v->brrRing[(v->brrRingPos + 10) % 12];
+  int old = v->brrRing[(v->brrRingPos + 11) % 12];
+  for (int i = 0; i < 4; ++i) {
+    uint8_t b = dsp->apu_ram[(v->brrAddress + v->brrByteOffset + i / 2) & 0xffff];
+    int x = (i & 1) ? (b & 15) : (b >> 4);
+    if (x > 7) x -= 16;
+    if (shift <= 12) x = (x * (1 << shift)) >> 1;
+    else x &= ~0x7ff;
+    if (filter == 1) x += old + (-old >> 4);
+    if (filter == 2) x += 2 * old + ((3 * -old) >> 5) - older + (older >> 4);
+    if (filter == 3) x += 2 * old + ((13 * -old) >> 6) - older + ((3 * older) >> 4);
+    x = x < -32768 ? -32768 : x > 32767 ? 32767 : x;
+    x = ((int16_t)((x & 0x7fff) << 1)) >> 1;
+    older = old; old = x;
+    v->brrRing[(v->brrRingPos + i) % 12] = x;
+  }
+  v->brrRingPos = (v->brrRingPos + 4) % 12;
+  v->brrByteOffset += 2;
+  if (v->brrByteOffset >= 9) {
+    v->brrByteOffset = 1;
+    if (header & 1) {
+      uint16_t ptr = dsp->dirPage + 4 * v->srcn;
+      v->brrAddress = dsp->apu_ram[(ptr + 2) & 0xffff] | (dsp->apu_ram[(ptr + 3) & 0xffff] << 8);
+      dsp->ram[0x7c] |= 1 << ch;
+    } else v->brrAddress += 9;
+  }
+}
