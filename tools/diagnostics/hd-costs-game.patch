diff --git a/src/course_orbit.c b/src/course_orbit.c
--- a/src/course_orbit.c
+++ b/src/course_orbit.c
@@ -1,3 +1,4 @@
+#include "hd_cost_profile.h"
 #include "course_orbit.h"
 #include "course_camera.h"
 #include "course_geometry.h"
@@ -1417,6 +1418,7 @@
      * the fully visible course returns. Camera state is retained. */
     if (PPU_forcedBlank(g_snes->ppu) || PPU_brightness(g_snes->ppu) != 15 ||
         PPU_mosaicSize(g_snes->ppu) > 1) return 0;
+    const double cost_started = KdcCostNow();
     const double started = Milliseconds();
     Render render = {.pixels = dst, .pitch = pitch, .width = width, .height = height,
                      .depth = depth_buffer, .ppu = g_snes->ppu, .hd = KdcHdEnabled(), .scale = scale,
@@ -1459,7 +1461,9 @@
     /* The terrain texture is rebuilt only where its inputs changed. Above
      * one output pixel per source pixel the enlarged level adds detail;
      * at or below it the source image already has more than is shown. */
+    double cost = KdcCostNow();
     render.terrain = KdcTerrainUpdate(render.ppu, g_ram, render.hd);
+    KdcCostEnd(kCost_terrain_update, cost);
     if (render.terrain) {
         const KdcTerrain *terrain = render.terrain;
         const bool enlarged = terrain->hd && render.camera.zoom > 1.000001;
@@ -1475,12 +1479,17 @@
     }
     render.samples = render.smooth ? 1 : Samples(render.camera.zoom);
     render.backdrop = Color(render.ppu->cgram[0]);
+    cost = KdcCostNow();
     if (SceneryLayout(render.ppu))
         render.scenery = KdcSceneryUpdate(render.ppu, g_ram, render.hd && scale > 1);
+    KdcCostEnd(kCost_scenery_update, cost);
     if (!ProjectFaces(&render)) return 0;
     PreparePieces(&render);
+    KdcCostEnd(kCost_orbit_prepare, cost_started);
+    cost = KdcCostNow();
     const double prepared = Milliseconds();
     KdcParallelFor((unsigned)((height + kBandRows - 1) / kBandRows), DrawBand, &render);
+    KdcCostEnd(kCost_orbit_parallel, cost);
     ReportProfile(prepared - started, Milliseconds() - prepared);
     return 1;
 }
diff --git a/src/host_parallel.c b/src/host_parallel.c
--- a/src/host_parallel.c
+++ b/src/host_parallel.c
@@ -2,6 +2,7 @@
 #define _POSIX_C_SOURCE 200809L
 #endif
 #include "host_parallel.h"
+#include "hd_cost_profile.h"
 
 #include <stdatomic.h>
 #include <stdbool.h>
@@ -142,9 +143,12 @@
 {
     if (!count || !task) return;
     if (KdcParallelThreads() == 1 || count == 1) {
+        double cost = KdcCostNow();
         for (unsigned i = 0; i < count; ++i) task(context, i);
+        KdcCostEnd(kCost_main_tasks, cost);
         return;
     }
+    double cost = KdcCostNow();
     Lock(&pool.lock);
     /* A worker that woke late may still hold the previous, finished job. */
     while (pool.inside) {
@@ -152,6 +156,7 @@
         Relax();
         Lock(&pool.lock);
     }
+    KdcCostEnd(kCost_previous_workers, cost);
     pool.task = task;
     pool.context = context;
     pool.count = count;
@@ -160,9 +165,13 @@
     ++pool.generation;
     Unlock(&pool.lock);
     WakeAll(&pool.wake);
+    cost = KdcCostNow();
     Run(task, context, count);
+    KdcCostEnd(kCost_main_tasks, cost);
+    cost = KdcCostNow();
     /* The remaining pieces are already running on other threads and are
      * short; sleeping here would cost more than it saves. */
     for (unsigned spins = 0; atomic_load(&pool.finished) < count; ++spins)
         if (spins > 64) Relax();
+    KdcCostEnd(kCost_completion_wait, cost);
 }
