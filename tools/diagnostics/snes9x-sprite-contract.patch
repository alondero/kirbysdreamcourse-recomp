+
+void KdcSpriteClose()
+{
+	if ((sprite_trace && fclose(sprite_trace)) || (sprite_state && fclose(sprite_state)))
+		abort();
+	sprite_trace = sprite_state = NULL;
+	sprite_frame = detail_frame = state_index = instruction_pc = 0;
+	KdcSpriteDetail = false;
+	KdcSpriteWatchLayouts = false;
+}
+
+void KdcSpriteFrame()
+{
+	if (++sprite_frame == 1)
+	{
+		const char *trace = getenv("KDC_SPRITE_REFERENCE_TRACE");
+		if (!trace || !*trace)
+			return;
+		sprite_trace = fopen(trace, "wb");
+		const char *frame = getenv("KDC_SPRITE_REFERENCE_DETAIL");
+		detail_frame = frame ? strtoul(frame, NULL, 10) : 0;
+		const char *state = getenv("KDC_SPRITE_REFERENCE_STATE");
+		sprite_state = state && *state ? fopen(state, "wb") : NULL;
+		KdcSpriteWatchLayouts = getenv("KDC_SPRITE_REFERENCE_WATCH_LAYOUTS") != NULL;
+		if (!sprite_trace || (state && *state && !sprite_state))
+			abort();
+	}
+	if (sprite_trace)
+		fprintf(sprite_trace, "F %u\n", sprite_frame);
+	KdcSpriteDetail = sprite_trace && sprite_frame == detail_frame;
+}
+
+static bool SpriteCode(unsigned pc)
+{
+	const unsigned bank = (pc >> 16) & 0x7f, address = pc & 0xffff;
+	return (bank == 0 && ((address >= 0x8823 && address < 0x8870) ||
+		(address >= 0x8a1a && address < 0x8f80))) ||
+		(bank == 1 && address >= 0x9fc3 && address <= 0xa0bf);
+}
+
+static bool SpriteBoundary(unsigned pc)
+{
+	if (pc == 0x04efc1 || pc == 0x84efc1)
+		return true;
+	switch (pc & 0x7fffff)
+	{
+		case 0x019fc3: case 0x019fdc: case 0x01a045: case 0x01a0a3: case 0x01a0b6:
+		case 0x0798c9:
+			return true;
+	}
+	if ((pc >> 16) != 0x00 && (pc >> 16) != 0x80)
+		return false;
+	switch (pc & 0xffff)
+	{
+		case 0x82ca: case 0x8823: case 0x8841: case 0x8ae1:
+		case 0x8a1a: case 0x8a1e: case 0x8a3d: case 0x8b02: case 0x8b09:
+		case 0x8c08: case 0x8c12: case 0x8d89: case 0x8e39: case 0x8ed8:
+		case 0x9e9e: case 0x9eec: case 0xdfc0: case 0xe525: case 0xe55e:
+		case 0xe5a6: case 0xe60b: case 0xe635: case 0xe776:
+			return true;
+		default:
+			return false;
+	}
+}
+
+static void SpriteRegisters(char tag, unsigned pc)
+{
+	const unsigned status = (Registers.PL & ~(Zero | Negative | Carry | Overflow)) |
+		ICPU._Carry | ((ICPU._Zero == 0) << 1) | (ICPU._Negative & 0x80) | (ICPU._Overflow << 6);
+	const unsigned s = Registers.S.W;
+	unsigned caller = 0;
+	// Read only the mirrored stack bytes. This is a return-address candidate.
+	if (s <= 0x1ffc)
+		caller = Memory.RAM[s + 1] | Memory.RAM[s + 2] << 8 | Memory.RAM[s + 3] << 16;
+	fprintf(sprite_trace, "%c %06x %04x %04x %04x %04x %04x %02x %02x %u %06x\n",
+		tag, pc, Registers.A.W, Registers.X.W, Registers.Y.W,
+		Registers.D.W, s, Registers.DB, status, !!CheckEmulation(), caller);
+}
+
+static void SpriteSnapshot()
+{
+	if (sprite_state)
+	{
+		fprintf(sprite_trace, "S %u\n", state_index++);
+		if (fwrite(Memory.RAM, sizeof(Memory.RAM), 1, sprite_state) != 1 ||
+			fwrite(Memory.SRAM, 8192, 1, sprite_state) != 1 ||
+			fwrite(PPU.OAMData, sizeof(PPU.OAMData), 1, sprite_state) != 1)
+			abort();
+	}
+}
+
+void KdcSpriteInstruction()
+{
+	const unsigned pc = Registers.PBPC;
+	if (SpriteBoundary(pc))
+	{
+		SpriteRegisters('B', pc);
+		if (KdcSpriteDetail)
+			SpriteSnapshot();
+	}
+	else if (KdcSpriteDetail && SpriteCode(pc))
+		SpriteRegisters('I', pc);
+}
+
+void KdcSpriteWrite(unsigned address, unsigned value, unsigned width, unsigned order)
+{
+	if (KdcSpriteDetail && SpriteCode(instruction_pc) && !CPU.InDMAorHDMA)
+		fprintf(sprite_trace, "W %06x %06x %u %04x %u\n", instruction_pc, address, width, value, order);
+	if (KdcSpriteWatchLayouts)
+		KdcSpriteLayoutWrite(address, value, width);
+}
+
+void KdcSpriteLayoutWrite(unsigned address, unsigned value, unsigned width)
+{
+	const unsigned bank = (address >> 16) & 0xff, offset = address & 0xffff;
+	if (bank != 0x7e && !((bank & 0x7f) < 0x40 && offset < 0x2000))
+		return;
+	if ((offset + width > 0x1200 && offset < 0x1600) ||
+		(offset + width > 0x0b1e && offset < 0x0b24))
+		fprintf(sprite_trace, "L %06x %06x %u %04x\n", instruction_pc, address, width, value);
+}
+
+void KdcSpriteDma(unsigned channel)
+{
+	const SDMA &dma = DMA[channel];
+	if (sprite_trace && !dma.ReverseTransfer && dma.BAddress == 4)
+		fprintf(sprite_trace, "D %06x %u %02x %02x%04x %04x %u %03x %u\n", instruction_pc,
+			channel, dma.BAddress, dma.ABank, dma.AAddress, dma.TransferBytes,
+			dma.TransferMode, PPU.OAMAddr, PPU.OAMFlip);
+}
+
+void KdcSpritePpu(unsigned address, unsigned value)
+{
+	fprintf(sprite_trace, "P %06x %u %02x %04x %02x\n", instruction_pc,
+		CPU.InDMAorHDMA, CPU.CurrentDMAorHDMAChannel & 0xff, address, value);
+}
