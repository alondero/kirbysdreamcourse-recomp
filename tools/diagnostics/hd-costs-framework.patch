+
+/* Diagnostic only. All counters are owned by the main thread; workers never
+ * write them. Retain samples in memory and flush after the replay. */
+static double kdc_cost_total[kCostCount], kdc_cost_previous[kCostCount];
+static struct { unsigned frame; double ms[kCostCount]; } kdc_cost_rows[36000];
+static unsigned kdc_cost_count;
+double KdcCostNow(void) { return MonotonicSeconds(); }
+void KdcCostEnd(unsigned stage, double start) {
+  kdc_cost_total[stage] += (MonotonicSeconds() - start) * 1000;
+}
+void KdcCostFrame(unsigned frame) {
+  if (kdc_cost_count == 36000) return;
+  kdc_cost_rows[kdc_cost_count].frame = frame;
+  for (unsigned i = 0; i < kCostCount; ++i) {
+    kdc_cost_rows[kdc_cost_count].ms[i] = kdc_cost_total[i] - kdc_cost_previous[i];
+    kdc_cost_previous[i] = kdc_cost_total[i];
+  }
+  ++kdc_cost_count;
+}
+void KdcCostDump(void) {
+  const char *path = getenv("KDC_COST_TRACE");
+  if (!path) return;
+  FILE *f = fopen(path, "w");
+  if (!f) return;
+  fprintf(f, "frame,ppu_hd_line_ms,ppu_hd_seed_ms,orbit_prepare_ms,terrain_update_ms,scenery_update_ms,orbit_parallel_ms,previous_workers_ms,main_tasks_ms,completion_wait_ms,hd_callback_ms,hd_downsample_ms,hd_surface_copy_ms,native_callback_ms,native_present_ms,freeze_copy_ms,stage_copy_ms,sdl_unlock_ms,sdl_submit_ms,sdl_present_ms,gl_upload_ms,gl_submit_ms,gl_swap_ms\n");
+  for (unsigned n = 0; n < kdc_cost_count; ++n) {
+    fprintf(f, "%u", kdc_cost_rows[n].frame);
+    for (unsigned i = 0; i < kCostCount; ++i) fprintf(f, ",%.6f", kdc_cost_rows[n].ms[i]);
+    fputc('\n', f);
+  }
+  fclose(f);
 }
